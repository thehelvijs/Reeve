# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Common build/deps (extend per stack)
node_modules/
dist/
build/
.env

# Go build artifacts
/bin/
*.test
*.out

# TS build info
*.tsbuildinfo

# Embedded UI: keep the placeholder index.html, ignore built assets copied by
# `make web-build`.
/server/webdist/*
!/server/webdist/index.html

# Staged host scripts + built agent binaries: keep placeholders, ignore
# artifacts copied by `make server-assets`.
/server/scripts/install.sh
/server/scripts/uninstall.sh
/server/agentdist/agent-linux-*

# SQLite data
*.db
*.db-wal
*.db-shm
.playwright-mcp/

# Playwright e2e artifacts, wherever the run was started from
test-results/
playwright-report/
web/.playwright/

# Python
__pycache__/
*.pyc
.claude/worktrees/

# Python
.pytest_cache/

# Superpowers specs/plans: local working docs, not part of the repo
docs/superpowers/

# Subagent-driven development scratch
.superpowers/

# Knowledge graph: graph.json and the report are committed so the team shares
# one map. The viewer, the extraction cache and the machine-local interpreter
# path are regenerated by `graphify export html` / `graphify update .`.
graphify-out/graph.html
graphify-out/cache/
graphify-out/cost.json
graphify-out/.graphify_python
graphify-out/.graphify_root
