# Reeve server configuration. Copy to deploy/.env and fill in. Never commit it.
# Compose reads .env from the compose file's directory, so it belongs here.

# The URL people reach this server on (scheme + host + port). Defaults to the
# host each request arrives on, which on a LAN is already the right answer. Set
# it for Google sign-in (the redirect URI must match exactly), or when the
# browser-facing address is not the one agents and emailed links should use.
REEVE_PUBLIC_URL=

# Set to true when a reverse proxy terminates HTTPS in front of the server, so
# the session cookie is only sent over HTTPS.
REEVE_COOKIE_SECURE=false

# Set to true only when a reverse proxy you control is the only way in. It
# makes the server read the client address from X-Forwarded-For, which is the
# login-throttle key and the source IP recorded against every credential
# reveal. With no such proxy, leave it false: the header is then just something
# any caller can type.
REEVE_TRUST_PROXY=false

# Extra origins allowed to make state-changing API calls with a session cookie.
# Only needed when the UI is served from somewhere other than this server, such
# as the Vite dev server: REEVE_ALLOWED_ORIGINS=http://127.0.0.1:5173
REEVE_ALLOWED_ORIGINS=

# Interface and port the server listens on under compose, which runs it on the
# host network. Every interface by default; narrow it to the one address the
# team reaches this on, e.g. REEVE_BIND=192.168.1.10.
REEVE_BIND=0.0.0.0
REEVE_PORT=8080

# Only used with docker-compose.pull.yml; the default build path ignores it.
# Pin a version in production.
REEVE_IMAGE=ghcr.io/thehelvijs/reeve:latest

# 32-byte master key, base64-encoded, used to encrypt credentials at rest.
# The server refuses to start without it. Losing it loses all stored secrets.
# Generate with: openssl rand -base64 32
REEVE_MASTER_KEY=

# Ed25519 release signing key, used only while building the image: the embedded
# agent binaries are signed with it and hosts refuse to self-update to an agent
# they cannot verify. Maintainers only. Paste the one line from the key file:
#   cat ~/.reeve/release-key
REEVE_SIGNING_KEY=

# --- agent (set these on each host, not on the server) ---
# REEVE_SERVER_URL=http://server-host:8080
# REEVE_AGENT_TOKEN=
# REEVE_PUSH_INTERVAL=15s
