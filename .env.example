# Reeve server configuration. Copy to .env and fill in. Never commit .env.

# Where the server listens. LAN-only: bind to a LAN interface, never a public one.
REEVE_ADDR=127.0.0.1:8080

# The URL people reach this server on (scheme + host + port). Required for
# Google sign-in, and used in emailed links and the agent install command.
REEVE_PUBLIC_URL=

# Set to true when a reverse proxy terminates HTTPS in front of the server, so
# the session cookie is only sent over HTTPS.
REEVE_COOKIE_SECURE=false

# Host port the compose file publishes on (container always listens on 8080).
REEVE_PORT=8080

# Container image the compose file pulls. Pin a version in production.
REEVE_IMAGE=ghcr.io/thehelvijs/reeve:latest

# 32-byte master key, base64-encoded, used to encrypt credentials at rest.
# The server refuses to start without it. Losing it loses all stored secrets.
# Generate with: openssl rand -base64 32
REEVE_MASTER_KEY=

# --- agent (set these on each host, not on the server) ---
# REEVE_SERVER_URL=http://server-host:8080
# REEVE_AGENT_TOKEN=
# REEVE_PUSH_INTERVAL=15s
